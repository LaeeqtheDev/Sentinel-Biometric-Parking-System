# Django
SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tesseract OCR (only needed on Windows usually)
# Example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Face Recognition tolerance (0.0 strict – 1.0 lenient). 0.6 is a good default.
FACE_MATCH_TOLERANCE=0.6

# ---------------------------------------------------------------
#  Sentinel backend configuration. Copy to .env and fill in.
# ---------------------------------------------------------------

# --- Core ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
ADMIN_URL=ops-admin/
TIME_ZONE=Asia/Karachi
BACKEND_BASE_URL=https://api.example.com

# --- Database (required in production) ---
DATABASE_URL=postgres://sentinel:password@db:5432/sentinel
DB_CONN_MAX_AGE=60

# --- Redis (required in production: cache, throttles, debounce, Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Frontend / CORS / WebAuthn ---
FRONTEND_BASE_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_ORIGINS=https://app.example.com

# --- Media storage (S3-compatible; leave blank to use local disk) ---
# Oracle Object Storage example endpoint:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_FILE_URL_TTL_SECONDS=900

# --- Recognition ---
RECOGNITION_ASYNC=True
RECOGNITION_TIMEOUT_SECONDS=8
OCR_MAX_WIDTH=1280
OCR_DEBOUNCE_SECONDS=30
FACE_MATCH_TOLERANCE=0.6
# Windows only: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Auth ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PASSKEY_TICKET_TTL_SECONDS=60
PICKUP_TOKEN_TTL_SECONDS=300

# --- Rate limits ---
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSKEY=30/min
THROTTLE_GATE=60/min
THROTTLE_CAMERA=120/min

# --- First admin (used by `manage.py seed_admin`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=INFO
